end

-- // VARIABEL KAMUS
local KamusWiktionary = {}
local url = "https://raw.githubusercontent.com/hddhsu/Wordsy/refs/heads/main/wiktionary_filtered.txt"

-- Mengunduh kamus dari GitHub
local sukses, hasilDownload = pcall(function()
    return game:HttpGet(url)
end)

if sukses then
    KamusWiktionary = string.split(hasilDownload, "\n")
    for i, kata in ipairs(KamusWiktionary) do
        KamusWiktionary[i] = string.match(kata, "^%s*(.-)%s*$")
    end
    print("Kamus berhasil dimuat! Total kata: " .. #KamusWiktionary)
else
    warn("Gagal mengunduh kamus dari GitHub!")
end

