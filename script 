-- // FITUR PENCARIAN KATA (WORD MATCHER)
SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = SearchBox.Text:lower()
    if query == "" then
        ResultLabel.Text = "Masukkan huruf untuk mencari kata..."
        return
    end
    
    local matches = {}
    for _, kata in ipairs(KamusWiktionary) do
        if string.sub(kata, 1, #query) == query then
            table.insert(matches, kata)
            if #matches >= 15 then break -- Batasi tampilkan 15 kata teratas agar tidak lag
            end
        end
    end
    
    if #matches > 0 then
        ResultLabel.Text = "Ditemukan (" .. #matches .. "+):\n" .. table.concat(matches, "\n")
    else
        ResultLabel.Text = "Kata tidak ditemukan!"
    end
end)

-- // FITUR DRAGGABLE (Bisa digeser)
local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- // FITUR GHOST MODE (Transparan Halus)
local isTransparent = false

GhostButton.MouseButton1Click:Connect(function()
    isTransparent = not isTransparent
    local bgTarget = isTransparent and 0.6 or 0
    local textTarget = isTransparent and 0.5 or 0
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    -- Animasikan frame utama dan komponennya
    TweenService:Create(MainFrame, tweenInfo, {BackgroundTransparency = bgTarget}):Play()
    TweenService:Create(GhostButton, tweenInfo, {BackgroundTransparency = bgTarget, TextTransparency = textTarget}):Play()
    TweenService:Create(SearchBox, tweenInfo, {BackgroundTransparency = bgTarget, TextTransparency = textTarget, PlaceholderTransparency = textTarget}):Play()
    TweenService:Create(ResultLabel, tweenInfo, {BackgroundTransparency = bgTarget, TextTransparency = textTarget}):Play()
    TweenService:Create(Title, tweenInfo, {TextTransparency = textTarget}):Play()
    TweenService:Create(StatusLabel, tweenInfo, {TextTransparency = textTarget}):Play()
    
    if isTransparent then
        GhostButton.Text = "Ghost Mode: ON"
    else
        GhostButton.Text = "Ghost Mode: OFF"
    end
end)
